{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Infinity Code",
    "version": "0.1.65"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      },
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "exists": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**"
        ]
      },
      "path": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "Infinity Code",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "decorations": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; frame-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src blob:; object-src 'none'"
    },
    "bundle": {
      "active": true,
      "targets": ["msi"],
      "identifier": "com.infinitycode.app",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
      "resources": ["binaries/infinity-backend.exe"],
      "windows": {
        "wix": {
          "language": "en-US"
        }
      }
    }
  }
}
